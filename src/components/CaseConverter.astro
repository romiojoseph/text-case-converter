---
import InputArea from "./InputArea.astro";
import OutputArea from "./OutputArea.astro";
import SettingsModal from "./SettingsModal.astro";
---

<div class="case-converter">
    <button id="settings-btn">Settings</button>
    <InputArea />

    <div class="tabs">
        <button class="tab-link active" data-tab="sentence-case"
            >Sentence case</button
        >
        <button class="tab-link" data-tab="lowercase">Lower case</button>
        <button class="tab-link" data-tab="uppercase">Uppercase</button>
        <button class="tab-link" data-tab="title-case">Title case</button>
        <button class="tab-link" data-tab="absolute-title-case"
            >Absolute Title</button
        >
        <button class="tab-link" data-tab="camel-case">Camel case</button>
        <button class="tab-link" data-tab="pascal-case">Pascal case</button>
        <button class="tab-link" data-tab="snake-case">Snake case</button>
        <button class="tab-link" data-tab="kebab-case">Kebab case</button>
    </div>

    <div id="sentence-case" class="tab-content active">
        <OutputArea label="Sentence case" id="output-sentence-case" />
    </div>
    <div id="lowercase" class="tab-content">
        <OutputArea label="Lower case" id="output-lowercase" />
    </div>
    <div id="uppercase" class="tab-content">
        <OutputArea label="Uppercase" id="output-uppercase" />
    </div>
    <div id="title-case" class="tab-content">
        <OutputArea label="Title case" id="output-title-case" />
    </div>
    <div id="absolute-title-case" class="tab-content">
        <OutputArea label="Absolute Title" id="output-absolute-title-case" />
    </div>
    <div id="camel-case" class="tab-content">
        <OutputArea label="Camel case" id="output-camel-case" />
    </div>
    <div id="pascal-case" class="tab-content">
        <OutputArea label="Pascal case" id="output-pascal-case" />
    </div>
    <div id="snake-case" class="tab-content">
        <OutputArea label="Snake case" id="output-snake-case" />
    </div>
    <div id="kebab-case" class="tab-content">
        <OutputArea label="Kebab case" id="output-kebab-case" />
    </div>

    <SettingsModal />
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const inputText = document.getElementById(
            "input-text",
        ) as HTMLTextAreaElement | null;
        const tabs = document.querySelectorAll(".tab-link");
        const tabContents = document.querySelectorAll(".tab-content");

        let commonWords: string[] = [];
        let exceptionWords: string[] = [];
        let removeSpecialCharsEnabled = false;
        let specialCharsList: string[] = [];

        function setOutputValue(id: string, value: string) {
            const element = document.getElementById(
                id,
            ) as HTMLTextAreaElement | null;
            if (element) {
                element.value = value;
            }
        }

        function loadSettings() {
            commonWords = (localStorage.getItem("commonWords") || "")
                .split(",")
                .map((w) => w.trim())
                .filter(Boolean);
            exceptionWords = (localStorage.getItem("exceptionWords") || "")
                .split(",")
                .map((w) => w.trim())
                .filter(Boolean);
            removeSpecialCharsEnabled =
                localStorage.getItem("removeSpecialCharsEnabled") === "true";
            specialCharsList = (localStorage.getItem("specialCharsList") || "")
                .split("\n")
                .filter(Boolean);
        }

        function removeSpecialChars(text: string): string {
            if (!removeSpecialCharsEnabled || specialCharsList.length === 0) {
                return text;
            }
            const escapedChars = specialCharsList
                .map((char) => char.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
                .join("");
            const regex = new RegExp(`[${escapedChars}]`, "g");
            return text.replace(regex, "");
        }

        function convertText() {
            if (!inputText) return;
            const text = inputText.value;
            const cleanedText = removeSpecialChars(text);

            setOutputValue("output-sentence-case", toSentenceCase(text));
            setOutputValue("output-lowercase", text.toLowerCase());
            setOutputValue("output-uppercase", text.toUpperCase());
            setOutputValue("output-title-case", toTitleCase(text));
            setOutputValue(
                "output-absolute-title-case",
                toAbsoluteTitleCase(text),
            );
            setOutputValue("output-camel-case", toCamelCase(cleanedText));
            setOutputValue("output-pascal-case", toPascalCase(cleanedText));
            setOutputValue("output-snake-case", toSnakeCase(cleanedText));
            setOutputValue("output-kebab-case", toKebabCase(cleanedText));
        }

        // --- All Conversion Functions ---

        function applyExceptions(str: string, exceptions: string[]): string {
            let tempStr = str;
            exceptions.forEach((exception) => {
                const regex = new RegExp(`\\b${exception}\\b`, "gi");
                tempStr = tempStr.replace(regex, exception);
            });
            return tempStr;
        }

        function toSentenceCase(str: string): string {
            const result = str
                .toLowerCase()
                .replace(/(^\s*\w|[.!?]\s*\w)/g, (c) => c.toUpperCase());
            return applyExceptions(result, exceptionWords);
        }

        function toTitleCase(str: string): string {
            const result = str
                .toLowerCase()
                .split(" ")
                .map((word, index) => {
                    if (index > 0 && commonWords.includes(word)) {
                        return word;
                    }
                    return word.charAt(0).toUpperCase() + word.slice(1);
                })
                .join(" ");
            return applyExceptions(result, exceptionWords);
        }

        function toAbsoluteTitleCase(str: string): string {
            return str
                .toLowerCase()
                .split(" ")
                .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
                .join(" ");
        }

        function toCamelCase(str: string): string {
            return str
                .replace(/(?:^\w|[A-Z]|\b\w)/g, (word, index) =>
                    index === 0 ? word.toLowerCase() : word.toUpperCase(),
                )
                .replace(/\s+/g, "");
        }

        function toPascalCase(str: string): string {
            return str
                .replace(/(?:^\w|[A-Z]|\b\w)/g, (word) => word.toUpperCase())
                .replace(/\s+/g, "");
        }

        function toSnakeCase(str: string): string {
            return str.trim().replace(/\s+/g, "_").toLowerCase();
        }

        function toKebabCase(str: string): string {
            return str.trim().replace(/\s+/g, "-").toLowerCase();
        }

        // --- Event Listeners ---

        loadSettings();
        convertText();

        inputText?.addEventListener("input", convertText);
        document.addEventListener("settingsUpdated", () => {
            loadSettings();
            convertText();
        });

        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const targetId = tab.getAttribute("data-tab");
                if (!targetId) return;

                const target = document.getElementById(targetId);

                tabs.forEach((t) => t.classList.remove("active"));
                tabContents.forEach((tc) => tc.classList.remove("active"));

                tab.classList.add("active");
                target?.classList.add("active");
            });
        });
    });
</script>
