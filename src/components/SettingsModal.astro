---
// No props needed
---

<div id="settings-modal" class="modal">
    <div class="modal-content">
        <header>
            <h2>Settings</h2>
            <button id="save-settings"
                ><i class="ph-fill ph-check-circle"></i>Save</button
            >
        </header>

        <div class="settings-grid">
            <div class="settings-group">
                <label>
                    <input type="checkbox" id="common-words-enabled" />
                    Common Words (lowercase)
                </label>
                <aside>
                    Words to keep lowercase in title case, separated by commas.
                </aside>
                <textarea id="common-words"></textarea>
            </div>

            <div class="settings-group">
                <label>
                    <input type="checkbox" id="exception-words-enabled" />
                    Exception Words (case-sensitive)
                </label>
                <aside>
                    Words to preserve their exact casing (e.g., SSH, npm).
                </aside>
                <textarea id="exception-words"></textarea>
            </div>

            <div class="settings-group">
                <label>
                    <input type="checkbox" id="remove-special-chars-enabled" />
                    Avoid Special Characters
                </label>
                <aside>
                    To remove characters below for Camel, Pascal, Snake, Kebab,
                    and Dot cases.
                </aside>
                <textarea
                    id="special-chars-list"
                    placeholder="Enter one character per line, e.g., . , ? !"
                ></textarea>
            </div>
            <div class="settings-group">
                <label for="alternating-case-mode">Alternating Case Mode</label>
                <aside>Choose how alternating case is applied.</aside>
                <div id="alternating-case-mode-group" class="radio-group">
                    <label>
                        <input
                            type="radio"
                            name="alternating-case-mode"
                            value="word"
                            checked
                        />
                        Word-wise <span class="hint">(DARK knight)</span>
                    </label>
                    <label>
                        <input
                            type="radio"
                            name="alternating-case-mode"
                            value="character"
                        />
                        Character-wise <span class="hint">(DaRk KnIgHt)</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // --- THIS IS THE CORRECTED IMPORT PATH ---
    // The path is now relative to the project's `src` directory.
    import exceptionsData from "/src/exceptions.json?raw";

    document.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById(
            "settings-modal",
        ) as HTMLElement | null;
        const settingsBtn = document.getElementById("settings-btn");
        const closeBtn = document.querySelector(
            ".close-btn",
        ) as HTMLElement | null;
        const saveBtn = document.getElementById("save-settings");

        const commonWordsCheckbox = document.getElementById(
            "common-words-enabled",
        ) as HTMLInputElement | null;
        const commonWordsTextarea = document.getElementById(
            "common-words",
        ) as HTMLTextAreaElement | null;
        const exceptionWordsCheckbox = document.getElementById(
            "exception-words-enabled",
        ) as HTMLInputElement | null;
        const exceptionWordsTextarea = document.getElementById(
            "exception-words",
        ) as HTMLTextAreaElement | null;
        const removeCharsCheckbox = document.getElementById(
            "remove-special-chars-enabled",
        ) as HTMLInputElement | null;
        const specialCharsTextarea = document.getElementById(
            "special-chars-list",
        ) as HTMLTextAreaElement | null;

        function openModal() {
            if (modal) {
                modal.style.display = "block";
                loadSettings();
            }
        }
        function closeModal() {
            if (modal) {
                modal.style.display = "none";
            }
        }

        settingsBtn?.addEventListener("click", openModal);
        closeBtn?.addEventListener("click", closeModal);
        window.addEventListener("click", (event) => {
            if (event.target == modal) {
                closeModal();
            }
        });

        function loadSettings() {
            if (
                !commonWordsTextarea ||
                !exceptionWordsTextarea ||
                !removeCharsCheckbox ||
                !specialCharsTextarea ||
                !commonWordsCheckbox ||
                !exceptionWordsCheckbox
            )
                return;

            const commonWords = localStorage.getItem("commonWords");
            const exceptionWords = localStorage.getItem("exceptionWords");
            const specialChars = localStorage.getItem("specialCharsList");

            if (!commonWords || !exceptionWords || !specialChars) {
                const data = JSON.parse(exceptionsData);
                commonWordsTextarea.value = data.commonWords.join(",");
                exceptionWordsTextarea.value = data.exceptionWords.join(",");
                specialCharsTextarea.value = data.specialCharacters.join("\n");
            } else {
                commonWordsTextarea.value = commonWords;
                exceptionWordsTextarea.value = exceptionWords;
                specialCharsTextarea.value = specialChars;
            }

            commonWordsCheckbox.checked =
                localStorage.getItem("commonWordsEnabled") !== "false";
            exceptionWordsCheckbox.checked =
                localStorage.getItem("exceptionWordsEnabled") !== "false";
            removeCharsCheckbox.checked =
                localStorage.getItem("removeSpecialCharsEnabled") === "true";

            const savedMode =
                localStorage.getItem("alternatingCaseMode") || "word";
            const radioToCheck = document.querySelector(
                `input[name="alternating-case-mode"][value="${savedMode}"]`,
            ) as HTMLInputElement | null;
            if (radioToCheck) {
                radioToCheck.checked = true;
            }
        }

        saveBtn?.addEventListener("click", () => {
            if (
                !commonWordsTextarea ||
                !exceptionWordsTextarea ||
                !removeCharsCheckbox ||
                !specialCharsTextarea ||
                !commonWordsCheckbox ||
                !exceptionWordsCheckbox
            )
                return;

            localStorage.setItem(
                "commonWordsEnabled",
                String(commonWordsCheckbox.checked),
            );
            localStorage.setItem("commonWords", commonWordsTextarea.value);
            localStorage.setItem(
                "exceptionWordsEnabled",
                String(exceptionWordsCheckbox.checked),
            );
            localStorage.setItem(
                "exceptionWords",
                exceptionWordsTextarea.value,
            );
            localStorage.setItem(
                "removeSpecialCharsEnabled",
                String(removeCharsCheckbox.checked),
            );
            localStorage.setItem(
                "specialCharsList",
                specialCharsTextarea.value,
            );

            const checkedRadio = document.querySelector(
                'input[name="alternating-case-mode"]:checked',
            ) as HTMLInputElement | null;
            if (checkedRadio) {
                localStorage.setItem("alternatingCaseMode", checkedRadio.value);
            }

            closeModal();
            document.dispatchEvent(new CustomEvent("settingsUpdated"));
        });

        loadSettings();
    });
</script>
