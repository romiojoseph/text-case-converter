---
// No props needed
---

<div id="settings-modal" class="modal">
    <div class="modal-content">
        <span class="close-btn">&times;</span>
        <h2>Settings</h2>

        <div class="settings-group">
            <label for="common-words">Common Words (lowercase)</label>
            <p>Words to keep lowercase in title case, separated by commas.</p>
            <textarea id="common-words"></textarea>
        </div>

        <div class="settings-group">
            <label for="exception-words">Exception Words (case-sensitive)</label
            >
            <p>Words to preserve their exact casing (e.g., SSH, npm).</p>
            <textarea id="exception-words"></textarea>
        </div>

        <div class="settings-group">
            <label>
                <input type="checkbox" id="remove-special-chars-enabled" />
                Avoid Special Characters
            </label>
            <p>
                Enable to remove characters below for Camel, Pascal, Snake,
                Kebab, and Dot cases.
            </p>
            <textarea
                id="special-chars-list"
                placeholder="Enter one character per line, e.g., . , ? !"
            ></textarea>
        </div>

        <div class="settings-group">
            <label for="alternating-case-mode">Alternating Case Mode</label>
            <p>Choose how alternating case is applied.</p>
            <select id="alternating-case-mode">
                <option value="word">Word-wise (An EASY to USE title)</option>
                <option value="character"
                    >Character-wise (An EaSy To UsE TiTlE)</option
                >
            </select>
        </div>

        <button id="save-settings">Save</button>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById(
            "settings-modal",
        ) as HTMLElement | null;
        const settingsBtn = document.getElementById("settings-btn");
        const closeBtn = document.querySelector(
            ".close-btn",
        ) as HTMLElement | null;
        const saveBtn = document.getElementById("save-settings");

        const commonWordsTextarea = document.getElementById(
            "common-words",
        ) as HTMLTextAreaElement | null;
        const exceptionWordsTextarea = document.getElementById(
            "exception-words",
        ) as HTMLTextAreaElement | null;
        const removeCharsCheckbox = document.getElementById(
            "remove-special-chars-enabled",
        ) as HTMLInputElement | null;
        const specialCharsTextarea = document.getElementById(
            "special-chars-list",
        ) as HTMLTextAreaElement | null;
        const alternatingCaseSelect = document.getElementById(
            "alternating-case-mode",
        ) as HTMLSelectElement | null;

        function openModal() {
            if (modal) {
                modal.style.display = "block";
                loadSettings();
            }
        }
        function closeModal() {
            if (modal) {
                modal.style.display = "none";
            }
        }

        settingsBtn?.addEventListener("click", openModal);
        closeBtn?.addEventListener("click", closeModal);
        window.addEventListener("click", (event) => {
            if (event.target == modal) {
                closeModal();
            }
        });

        function loadSettings() {
            if (
                !commonWordsTextarea ||
                !exceptionWordsTextarea ||
                !removeCharsCheckbox ||
                !specialCharsTextarea ||
                !alternatingCaseSelect
            )
                return;

            const commonWords = localStorage.getItem("commonWords");
            const exceptionWords = localStorage.getItem("exceptionWords");
            const specialChars = localStorage.getItem("specialCharsList");

            if (!commonWords || !exceptionWords || !specialChars) {
                fetch("/exceptions.json")
                    .then((response) => response.json())
                    .then((data) => {
                        commonWordsTextarea.value = data.commonWords.join(",");
                        exceptionWordsTextarea.value =
                            data.exceptionWords.join(",");
                        specialCharsTextarea.value =
                            data.specialCharacters.join("\n");
                    });
            } else {
                commonWordsTextarea.value = commonWords;
                exceptionWordsTextarea.value = exceptionWords;
                specialCharsTextarea.value = specialChars;
            }

            removeCharsCheckbox.checked =
                localStorage.getItem("removeSpecialCharsEnabled") === "true";
            alternatingCaseSelect.value =
                localStorage.getItem("alternatingCaseMode") || "word";
        }

        saveBtn?.addEventListener("click", () => {
            if (
                !commonWordsTextarea ||
                !exceptionWordsTextarea ||
                !removeCharsCheckbox ||
                !specialCharsTextarea ||
                !alternatingCaseSelect
            )
                return;

            localStorage.setItem("commonWords", commonWordsTextarea.value);
            localStorage.setItem(
                "exceptionWords",
                exceptionWordsTextarea.value,
            );
            localStorage.setItem(
                "removeSpecialCharsEnabled",
                String(removeCharsCheckbox.checked),
            );
            localStorage.setItem(
                "specialCharsList",
                specialCharsTextarea.value,
            );
            localStorage.setItem(
                "alternatingCaseMode",
                alternatingCaseSelect.value,
            );

            closeModal();
            document.dispatchEvent(new CustomEvent("settingsUpdated"));
        });

        loadSettings();
    });
</script>
