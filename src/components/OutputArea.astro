---
export interface Props {
    label: string;
    id: string;
}

const { label, id } = Astro.props;
---

<div class="output-area">
    <label for={id}>{label}</label>
    <div class="output-wrapper">
        <textarea id={id} readonly></textarea>
        <button class="copy-btn" data-target={id}>Copy</button>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const copyBtns = document.querySelectorAll(".copy-btn");
        copyBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const targetId = btn.getAttribute("data-target");
                const outputText = document.getElementById(targetId);
                outputText.select();
                document.execCommand("copy");
            });
        });
    });
</script>

<style>
    .output-area {
        margin-bottom: 20px;
    }

    .output-wrapper {
        display: flex;
        align-items: center;
    }

    textarea {
        width: 100%;
        height: 100px;
        padding: 10px;
        border-radius: 5px;
        border: 1px solid #ccc;
        resize: vertical;
        margin-right: 10px;
    }

    button {
        padding: 10px;
        border-radius: 5px;
        border: none;
        background-color: #28a745;
        color: white;
        cursor: pointer;
    }
</style>
