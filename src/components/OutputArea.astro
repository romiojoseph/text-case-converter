---
export interface Props {
    label: string;
    id: string;
}

const { label, id } = Astro.props;
---

<div class="output-area">
    <label for={id}>{label}</label>
    <div class="output-wrapper">
        <textarea id={id} readonly></textarea>
        <button class="copy-btn" data-target={id}>Copy</button>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const copyBtns = document.querySelectorAll(".copy-btn");
        const notification = document.getElementById("copy-notification");

        copyBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const targetId = btn.getAttribute("data-target");
                if (!targetId) return; // Exit if the data-target attribute is missing

                const outputText = document.getElementById(
                    targetId,
                ) as HTMLTextAreaElement | null;

                // Check if the element exists and has a select method
                if (outputText && typeof outputText.select === "function") {
                    outputText.select();
                    navigator.clipboard.writeText(outputText.value).then(() => {
                        // Show notification on successful copy
                        if (notification) {
                            notification.classList.add("show");
                            setTimeout(() => {
                                notification.classList.remove("show");
                            }, 3000); // Hide after 3 seconds
                        }
                    });
                }
            });
        });
    });
</script>
