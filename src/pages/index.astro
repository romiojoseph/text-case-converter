---
import Layout from "../layouts/Layout.astro";
import CaseConverter from "../components/CaseConverter.astro";
---

<Layout title="Text Case Converter">
	<main>
		<h1>Text Case Converter</h1>
		<CaseConverter />
	</main>
</Layout>

<style>
	main {
		margin: auto;
		padding: 1rem;
		width: 800px;
		max-width: calc(100% - 2rem);
		color: white;
		font-size: 20px;
		line-height: 1.6;
	}
</style>
